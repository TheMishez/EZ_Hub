{
  "name": "ez-hub",
  "productName": "EZ Hub",
  "version": "1.0.0",
  "description": "One window for the Pulsar (Bibimbap) and Razer Synapse Web drivers.",
  "main": "main.js",
  "author": "EZGGco",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ezggco.ezhub",
    "productName": "EZ Hub",
    "files": [
      "main.js",
      "preload-ui.js",
      "preload-picker.js",
      "ui.html",
      "picker.html",
      "build/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  }
}
